<Page
    x:Class="HourSync.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HourSync"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DataContext="{d:DesignInstance Type=local:LoginViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="pageTitle"
                   x:Uid="LoginTitleText"
                   Margin="36, 40, 0, 36"
                   Style="{StaticResource TitleTextBlockStyle}"/>

        <Image x:Name="loginBanner"
               Grid.Row="1"
               Source="ms-appx:///Assets/hoursync-dark-login-banner.png"
               Stretch="Uniform"
               MaxHeight="375"
               Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,12">
            <TextBox x:Name="UsernameTextBox"
                 Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderBrush="{Binding BorderBrush, Mode=OneWay}"
                 BorderThickness="{Binding BorderThickness, Mode=OneWay}"
                 x:Uid="LoginUsername"
                 Width="200"
                 Margin="0,0,10,0"
                 PreviewKeyDown="UsernameTextBox_KeyDown"
                 PreviewKeyUp="UsernameTextBox_KeyUp"/>
            <PasswordBox x:Name="PasswordBox"
                         x:Uid="LoginPassword"
                         Width="200"
                         Margin="0"
                         KeyDown="PasswordBox_KeyDown"
                         BorderThickness="0"
                         BorderBrush="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Vertical"
                    HorizontalAlignment="Center">
            <Button Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    Foreground="White"
                    Grid.Row="3"
                    x:Uid="LoginButton"
                    Click="LoginButton_Click"
                    HorizontalAlignment="Center"
                    Margin="0, 0, 0, 10"
                    x:Name="LoginButton"/>
            <HyperlinkButton x:Name="ForgotPassword"
                             Click="ForgotPassword_Click"
                             x:Uid="LoginForgotPassword"/>
        </StackPanel>
    </Grid>
</Page>