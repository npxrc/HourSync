	<PropertyGroup>
		<Version>1.9.0</Version>
		<AssemblyVersion>1.9.0.0</AssemblyVersion>
	</PropertyGroup>

	<Target Name="UpdateAppxManifestVersion" BeforeTargets="GenerateAppxPackage">
		<XmlPoke XmlInputPath="Package.appxmanifest" Query="/Package/Identity/@Version" Value="$(AssemblyVersion)" />
		<XmlPoke XmlInputPath="Package.appxmanifest" Query="/Package/Identity/@Version" Value="$(AssemblyVersion)" />
	</Target>

	<Target Name="CustomActionAfterPublish" AfterTargets="Publish">
		<Exec Command="&quot;C:\Program Files (x86)\Inno Setup 6\ISCC.exe&quot; /Dappver=$(Version) &quot;$(ProjectDir)setup.iss&quot;" />
	</Target>

	<PropertyGroup>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

</Project>
