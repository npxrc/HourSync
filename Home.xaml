<Page
    x:Class="HourSync.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:HourSyncCoreLib"
    mc:Ignorable="d">

    <Grid Margin="36, 40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Content for the top row -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock x:Name="StudentName" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="StudentAcademy" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="StudentEHours" Style="{ThemeResource BodyTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Progress to Endorsement:"/>
                <TextBlock x:Name="progressToEndorsementText" Text="0%" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="4, 0, 0, 0"/>
            </StackPanel>
            <ProgressBar x:Name="StudentEHourProgress" Margin="0,10" Width="500px" HorizontalAlignment="Left" ToolTipService.ToolTip="Your progress towards 200 eHours"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Logout" Click="Logout_Click" Margin="0, 0, 10, 0"/>

                <DropDownButton x:Name="SortDropDown" Content="Sort by" ToolTipService.ToolTip="Sort" AutomationProperties.Name="Sort" Margin="0,0,10,0">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Date (Old to New)" Click="SortDateOtoN"/>
                            <MenuFlyoutItem Text="Date (New to Old)" Click="SortDateNtoO"/>
                            <MenuFlyoutItem Text="Name (A to Z)" Click="SortNameAtoZ"/>
                            <MenuFlyoutItem Text="Name (Z to A)" Click="SortNameZtoA"/>
                            <MenuFlyoutItem Text="Hours (Low to High)" Click="SortHoursLtoH"/>
                            <MenuFlyoutItem Text="Hours (High to Low)" Click="SortHoursHtoL"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button x:Name="OpenReSyncButton" IsEnabled="False" Content="View ReSync" Click="OpenReSync_Click" ToolTipService.ToolTip="Open ReSync" Margin="0, 0, 10, 0"/>

                <Button x:Name="ReloadHomeButton" Content="Reload" Click="ReloadHomeContent_Click" ToolTipService.ToolTip="Fetches the home content again."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBox x:Name="SearchBox" 
                     Width="300"
                     PlaceholderText="Search requests..."
                         TextChanged="Search"/>
            </StackPanel>
        </StackPanel>

        <!-- Main content grid in the second row -->
        <Grid Grid.Row="1" x:Name="RequestsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ScrollViewer in the first column -->
            <ScrollViewer Grid.Column="0" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RequestsPanel" Margin="0, 0, 0, 10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pending Requests -" Margin="0,0,5,0"/>
                        <TextBlock Text="{x:Bind PendingRequests.Count, Mode=OneWay}"/>
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind PendingRequests, Mode=OneWay}" SelectionMode="None" Margin="-15, 5, 0, 0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:EHourRequest">
                                <Button
                                    Tag="{x:Bind Value}" 
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="80"
                                    Margin="0,0,0,10"
                                    Click="RequestButton_Click"
                                    RightTapped="HandleRightClick">
                                    <Button.Content>
                                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
                                            <Run Text="{x:Bind Description}"/>
                                            <LineBreak/>
                                            <Run Text="Hours:"/>
                                            <Run Text="{x:Bind Hours}"/>
                                            <LineBreak/>
                                            <Run Text="Date:"/>
                                            <Run Text="{x:Bind Date}"/>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Accepted Requests -" Margin="0,0,5,0"/>
                        <TextBlock Text="{x:Bind AcceptedRequests.Count, Mode=OneWay}"/>
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind AcceptedRequests, Mode=OneWay}" SelectionMode="None" Margin="-15, 5, 0, 0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:EHourRequest">
                                <Button
                                    Tag="{x:Bind Value}" 
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="80"
                                    Margin="0,0,0,10"
                                    Click="RequestButton_Click"
                                    RightTapped="HandleRightClick">
                                    <Button.Content>
                                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
                                            <Run Text="{x:Bind Description}"/>
                                            <LineBreak/>
                                            <Run Text="Hours:"/>
                                            <Run Text="{x:Bind Hours}"/>
                                            <LineBreak/>
                                            <Run Text="Date:"/>
                                            <Run Text="{x:Bind Date}"/>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Returned Requests -" Margin="0,0,5,0"/>
                        <TextBlock Text="{x:Bind ReturnedRequests.Count, Mode=OneWay}"/>
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind ReturnedRequests, Mode=OneWay}" SelectionMode="None" Margin="-15, 5, 0, 0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:EHourRequest">
                                <Button
                                    Tag="{x:Bind Value}" 
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="80"
                                    Margin="0,0,0,10"
                                    Click="RequestButton_Click"
                                    RightTapped="HandleRightClick">
                                    <Button.Content>
                                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
                                            <Run Text="{x:Bind Description}"/>
                                            <LineBreak/>
                                            <Run Text="Hours:"/>
                                            <Run Text="{x:Bind Hours}"/>
                                            <LineBreak/>
                                            <Run Text="Date:"/>
                                            <Run Text="{x:Bind Date}"/>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Denied Requests -" Margin="0,0,5,0"/>
                        <TextBlock Text="{x:Bind DeniedRequests.Count, Mode=OneWay}"/>
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind DeniedRequests, Mode=OneWay}" SelectionMode="None" Margin="-15, 5, 0, 0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:EHourRequest">
                                <Button
                                    Tag="{x:Bind Value}" 
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="80"
                                    Margin="0,0,0,10"
                                    Click="RequestButton_Click"
                                    RightTapped="HandleRightClick">
                                    <Button.Content>
                                        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap">
                                            <Run Text="{x:Bind Description}"/>
                                            <LineBreak/>
                                            <Run Text="Hours:"/>
                                            <Run Text="{x:Bind Hours}"/>
                                            <LineBreak/>
                                            <Run Text="Date:"/>
                                            <Run Text="{x:Bind Date}"/>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>